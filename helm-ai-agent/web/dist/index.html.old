<!doctype html><html lang="ko"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Manifest → Helm (Bedrock)</title>
<style>
body{font-family:system-ui,sans-serif;max-width:900px;margin:40px auto;padding:0 16px}
textarea{width:100%;height:320px}.row{display:flex;gap:12px;align-items:center;margin:8px 0}
input[type=text]{flex:1;padding:8px}.btn{padding:10px 16px;cursor:pointer;border:1px solid #ccc;background:#f7f7f7}
.btn:disabled{opacity:.5;cursor:not-allowed}.hint{color:#666;font-size:12px}.box{border:1px dashed #aaa;padding:16px}
</style></head><body>
<h1>Manifest → Helm Chart (Bedrock)</h1>
<div class="row"><label>Chart 이름</label><input type="text" id="chartName" value="myapp"/></div>
<div class="box"><div class="row">
<input type="file" id="file" accept=".yml,.yaml"/><span class="hint">또는 아래에 붙여넣기</span></div>
<textarea id="yaml" placeholder="Kubernetes YAML을 붙여넣으세요"></textarea></div>
<div class="row"><label><input type="checkbox" id="ing"/> Ingress 기본 활성화</label>
<button class="btn" id="go">변환하기</button></div>
<pre id="log" class="hint"></pre>
<script>
const chartName=document.getElementById('chartName'),yaml=document.getElementById('yaml'),
ing=document.getElementById('ing'),file=document.getElementById('file'),log=document.getElementById('log');
file.onchange=async()=>{const f=file.files[0]; if(!f)return; yaml.value=await f.text()};
document.getElementById('go').onclick=async()=>{
  const name=chartName.value.trim(), text=yaml.value.trim();
  if(!name||!text){log.textContent="chart 이름과 YAML을 입력하세요.";return;}
  log.textContent="변환 중...";
  try{
    const res=await fetch("/api/convert",{method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({chart_name:name,manifest_yaml:text,defaults:{ingress:{enabled:ing.checked}}})});
    if(!res.ok){const e=await res.json().catch(()=>({error:res.statusText}));throw new Error(e.error||res.statusText)}
    const b=await res.blob();const a=document.createElement('a');
    a.href=URL.createObjectURL(b);a.download=`${name}.zip`;a.click();
    log.textContent="완료! ZIP 다운로드.";
  }catch(e){log.textContent="에러: "+e.message}
};
</script></body></html>
